# error, warn, info, http, verbose, debug or silly (default info)
LOG_LEVEL=info
# pretty (default) or json, one object per line for log collectors
LOG_FORMAT=pretty
PORT=3001
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://checklog:checklog@localhost:5432/checklog
# Dev and staging only: run migrations when the API starts (default off)
MIGRATE_ON_START=false

BETTER_AUTH_SECRET=your_secret_here

# Mailpit in docker-compose.yaml; view sent mail at http://localhost:8025
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=checklog@example.com
EMAIL_FROM_NAME=Checklog
