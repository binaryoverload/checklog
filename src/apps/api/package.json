{
  "name": "@checklog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../../LICENSE",
  "scripts": {
    "dev": "tsx watch --import dotenv/config src/index.ts",
    "dev:worker": "tsx watch --import dotenv/config src/worker.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "start:worker": "node dist/worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --import dotenv/config src/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@checklog/shared": "workspace:*",
    "better-auth": "catalog:",
    "cors": "catalog:",
    "drizzle-orm": "catalog:",
    "es-toolkit": "catalog:",
    "express": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "rrule": "catalog:",
    "typeid-js": "catalog:",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/ui": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}